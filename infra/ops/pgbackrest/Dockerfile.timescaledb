# timescaledb + pgBackRest derived image
#
# Purpose: the base image `timescale/timescaledb:2.13.1-pg16` does not include the pgbackrest binary,
# and PG's WAL archiving relies on the locally executed archive_command (`pgbackrest ... archive-push %p`),
# so the DB container must have pgbackrest — which is also half of the official "dual-host same-version" requirement
# (verified external/pgbackrest/doc/xml/user-guide.xml:2770).
#
# Only stack the PGDG pgbackrest package on top of the base image, **without modifying** timescaledb itself,
# reducing compatibility risk with the existing init.sql / data volumes.
FROM timescale/timescaledb:2.13.1-pg16

# This base image is Alpine-based (timescaledb official 2.13.1-pg16 is alpine-based, includes apk).
# pgbackrest does not publish a package in the Alpine repo; the Alpine install path is building from source.
# To ensure "auditable + official path", here we use Alpine build deps + official source build,
# with the version pinned to match the repository side (2.59.3).
#
# ⚠️ Fact note: the underlying distro (alpine vs debian) of timescaledb 2.13.1-pg16 is **not verified** in this repo.
#   If the build reports `apk: not found`, it is debian-based; use the apt branch in the comment below.
ARG PGBACKREST_VERSION=2.59.3

# --- Alpine branch (expected) ---
WORKDIR /tmp
RUN apk add --no-cache \
        build-base meson ninja pkgconf \
        libpq-dev openssl-dev libxml2-dev lz4-dev bzip2-dev zlib-dev zstd-dev libssh2-dev \
        make gcc g++ curl \
 && curl -fsSL "https://github.com/pgbackrest/pgbackrest/archive/refs/tags/release/${PGBACKREST_VERSION}.tar.gz" -o pgbackrest.tar.gz \
 && tar xzf pgbackrest.tar.gz \
 # Build dir uses the source dir name (official distribution.xml build flow: meson setup build .)
 && cd "pgbackrest-release-${PGBACKREST_VERSION}" \
 && meson setup build . \
 && ninja -C build \
 && cp build/src/pgbackrest /usr/local/bin/pgbackrest \
 && chmod 755 /usr/local/bin/pgbackrest \
 # Build-time self-check: the binary must be executable and the version correct, otherwise the image build fails
 && pgbackrest version \
 && cd /tmp \
 && rm -rf pgbackrest.tar.gz "pgbackrest-release-${PGBACKREST_VERSION}" \
 # Remove build deps to shrink the image (keep runtime libs: libpq/openssl/libxml2/lz4/zstd/bz2/zlib)
 && apk del build-base meson ninja pkgconf openssl-dev libxml2-dev lz4-dev bzip2-dev zstd-dev libssh2-dev \
 && rm -rf /var/cache/apk/*

# jq: the DB-side `monitor.pgbackrest_info()` (official user-guide.xml Monitoring example)
# and its derived queries parse `pgbackrest --output=json info`, so install it in the image.
RUN apk add --no-cache jq \
 && jq --version
# Build-time self-check: both the binary and the parsing tool are present.
RUN pgbackrest version

# Official log directory (user-guide.xml:626-637)
RUN mkdir -p /var/log/pgbackrest \
 && chmod 770 /var/log/pgbackrest \
 && chown postgres:postgres /var/log/pgbackrest

# Config is injected via read-only mount (see compose), not COPYed into the image — avoid baking secrets/config into the image
# (AGENTS.md §5).
