    {
      "id": 1,
      "type": "stat",
      "title": "Ingestion throughput (rows/s)",
      "description": "rate(robot_backend_telemetry_written_total[1m]): rows BatchWriter writes to TimescaleDB per second. Steady state for 100 units × 10Hz should be ~1000 rows/s. Metric source backend_ingestion/app/metrics.py:62",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(robot_backend_telemetry_written_total[1m]))",
          "legendFormat": "rows/s",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rows/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
