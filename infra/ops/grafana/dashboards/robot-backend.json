      "title": "落库吞吐（行/秒）",
      "description": "rate(robot_backend_telemetry_written_total[1m])：BatchWriter 每秒写入 TimescaleDB 的行数。100 台 × 10Hz 稳态应为 ~1000 rows/s。指标源 backend_ingestion/app/metrics.py:62",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(robot_backend_telemetry_written_total[1m]))",
          "legendFormat": "rows/s",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rows/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
