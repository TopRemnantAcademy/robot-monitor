# CNB secret-repo file template: github-sync.yml under flow.237/RobotMonitor-secrets
#
# Usage:
#   1. This is a "template" -- do not fill in real values and commit it to this repo.
#   2. Create the secret repo flow.237/RobotMonitor-secrets on CNB (or change the imports
#      in .cnb.yml to point at your own path).
#   3. In the secret repo's web UI, create a new file github-sync.yml, copy the two lines
#      below into it, and fill in the real values.
#   4. .cnb.yml references it via imports and injects it as env vars for tencentcom/git-sync.
#
# Security constraints (see Issue #64):
#   - This repo never contains a real token; only the ${GIT_USERNAME} / ${GIT_ACCESS_TOKEN} placeholders appear.
#   - The secret repo must not be cloned locally; it can only be edited in the web UI, which has an audit log.
#   - Use least-privilege PAT: only grant Contents: Read and write on TopRemnantAcademy/robot-monitor.

# Username conventionally used when GitHub PAT goes over HTTPS; a fixed value is fine; the token is the only credential.
GIT_USERNAME: x-access-token

# Fine-grained Personal Access Token (do not use a classic token, and do not use a password).
GIT_ACCESS_TOKEN: REPLACE_WITH_FINE_GRAINED_PAT

# -- Optional: narrow this secret file's reference scope (recommended) -------------
# Once allow_* is declared, the trigger's role permissions are no longer considered; only these rules apply.
# allow_slugs: flow.237/RobotMonitor
# allow_events: push
# allow_branches: main
# allow_images: tencentcom/git-sync
