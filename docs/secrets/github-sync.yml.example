# CNB 密钥仓库文件模板：flow.237/RobotMonitor-secrets 下的 github-sync.yml
#
# 用法：
#   1. 这是一份「模板」，不要填真值后提交到本仓库。
#   2. 在 CNB 建密钥仓库 flow.237/RobotMonitor-secrets（或改 .cnb.yml 的 imports 指向你自己的路径）。
#   3. 在密钥仓库 Web 界面新建文件 github-sync.yml，把下面两行复制过去并填入真实值。
#   4. .cnb.yml 通过 imports 引用它，注入为环境变量供 tencentcom/git-sync 使用。
#
# 安全约束（对照 Issue #64）：
#   - 本仓库永不出现真实 token，只出现 ${GIT_USERNAME} / ${GIT_ACCESS_TOKEN} 占位符。
#   - 密钥仓库禁止 clone 到本地，只能在 Web 界面编辑，有审计日志。
#   - PAT 权限最小化：只给 TopRemnantAcademy/robot-monitor 的 Contents: Read and write。

# GitHub 用 PAT 走 HTTPS 时约定的用户名，固定值即可；token 才是唯一凭据。
GIT_USERNAME: x-access-token

# Fine-grained Personal Access Token（不要用 classic token，也不要用密码）。
GIT_ACCESS_TOKEN: REPLACE_WITH_FINE_GRAINED_PAT

# ── 可选：收敛该密钥文件的被引用范围（建议开启） ─────────────────────
# 一旦声明 allow_*，触发者的角色权限不再参与判断，只看这里的规则。
# allow_slugs: flow.237/RobotMonitor
# allow_events: push
# allow_branches: main
# allow_images: tencentcom/git-sync
