                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register:Register",
        "tags": [
          "auth"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "健康检查。\n\n`status` 反映**依赖可达性**，不只是「进程活着」：\n- `ok`       —— DB 与 Redis 都可达\n- `degraded` —— 进程活着但依赖不可达（此时写入会堆积到队列，需立刻告警）\n- 仍返回 HTTP 200：这是**存活探针**语义，改为 503 会让容器被重启掉，\n  而依赖恢复后本服务能自愈，重启反而丢在飞数据。依赖不健康由 `status` 字段表达。",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/metrics": {
      "get": {
        "description": "Prometheus 抓取端点（`infra/observability/prometheus.yml` 的 `robot_backend` job）。\n\n与 `/healthz` 的区别是**模型**而不是内容：`/healthz` 回瞬时快照，\n抓取端拿到的永远是\"上一次写入那一刻\"的值；这里的 Counter 是单调累加的，\nPrometheus 才能算出 `rate()` / `increase()`，让 1000 msg/s 有历史曲线。\n\n函数名**不能叫 `metrics`** —— 那会遮蔽模块名 `app.metrics`（`from app import metrics`）。",
        "operationId": "prometheus_metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Prometheus Metrics"
      }
    },
    "/robots": {
      "get": {
        "description": "100 台最新状态。只读端点：viewer 起可访问，返回体与加鉴权前逐字段一致。",
        "operationId": "list_robots_robots_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RobotListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Robots"
      }
    },
    "/robots/{robot_id}/history": {
      "get": {
        "description": "最近 N 分钟历史（供 Drawer 折线 + 关节热力图）。\n\n数据源（ISSUE #76 起）：**优先查连续聚合 `robot_history_10s`**，\n该视图的刷新策略是 end_offset=10s / schedule=30s，延迟在数十秒内\n（见 infra/init.sql §5.1），满足 Drawer 对「最近数据」的要求。\n\n为什么不再直查原始表：\n  原实现对 `robot_telemetry` 做 `time_bucket`，过滤 `time >= now() - 5min`。\n  100 台 × 10Hz = 1000 行/s ⇒ 5 分钟窗口内单台约 3000 行、全量扫描更多；\n  每次 Drawer 打开都要在原始 hypertable 上区间扫描 + 逐行 last() 聚合。\n  改查连续聚合后，同一查询只读「已预聚合的 ~30 行/台」，扫描量下降三个数量级\n  —— 这是真快，不是靠 Histogram 观测出来的假快。\n\n为什么保留原始表回退：\n  连续聚合在 `REFRESH` 之前是空的（`WITH NO DATA` + 策略异步刷新），\n  冷启动、策略 job 未跑到、或刷新窗口尚未覆盖时，直查会返回空数组 →\n  Drawer 曲线恒空。回退保证「聚合未就绪 ≠ 端点失效」，\n  语义与 spec/00 §5.3「聚合未就绪时回退原始表」逐字一致。\n\n`last(joint_positions, time)` 在两个分支中都**必须保留** ——\n它是 Drawer 第三条折线「角度(rad)」的唯一数据源\n（RobotDetailDrawer.tsx:88），缺了它曲线恒为 null（订单 16 踩过的坑）。",
        "operationId": "history_robots__robot_id__history_get",
        "parameters": [
          {
            "in": "path",
            "name": "robot_id",
            "required": true,
            "schema": {
              "title": "Robot Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "minutes",
            "required": false,
            "schema": {
              "default": 5,
              "title": "Minutes",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "resolution",
            "required": false,
            "schema": {
              "default": "10s",
              "title": "Resolution",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RobotHistoryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
