            "type": "integer"
          },
          "rows_written": {
            "title": "Rows Written",
            "type": "integer"
          },
          "status": {
            "description": "ok（DB/Redis 可达）| degraded（进程活着但依赖不可达）",
            "title": "Status",
            "type": "string"
