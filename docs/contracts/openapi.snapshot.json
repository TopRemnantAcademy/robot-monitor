  "info": {
    "title": "RobotMonitor Ingestion",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/alerts": {
      "get": {
        "description": "分页查询告警（解 H5）。\n\n只读，viewer 起可访问 —— 与 `GET /robots` 权限一致（看板必须所有人都能看）。\n典型用法：前端筛选「未确认」= `GET /alerts?ack=false&limit=50&offset=0`。\n\n`suppressed`（订单 35）刻意是**可选**参数，省略时返回全集（含被抑制行）。\n为什么不把「排除已抑制」设成默认：默认值一变，既有调用方（前端告警流、\nRobotDetailDrawer 的 200 条拉取）的行为会在没人改代码的情况下静默改变。\n把「默认视图要不要藏被抑制行」交给**调用方显式表达**，契约本身保持中性。\n\n注意这与「前端默认不进未确认流」是两件事：前者是 API 的中立性，\n后者是 `AlertLogTable` 的展示决策（默认 `suppressed=false` + 一个开关）。",
        "operationId": "list_alerts_alerts_get",
        "parameters": [
          {
            "description": "true/false 筛选确认状态；省略=全部",
            "in": "query",
            "name": "ack",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "true/false 筛选确认状态；省略=全部",
              "title": "Ack"
            }
          },
          {
            "description": "true 只看已升级告警",
            "in": "query",
            "name": "escalated",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "true 只看已升级告警",
              "title": "Escalated"
            }
          },
          {
            "description": "true 只看已抑制 / false 排除已抑制；省略=全部（含已抑制）",
            "in": "query",
            "name": "suppressed",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "true 只看已抑制 / false 排除已抑制；省略=全部（含已抑制）",
              "title": "Suppressed"
            }
          },
          {
            "description": "按机器人过滤",
            "in": "query",
            "name": "robot_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "按机器人过滤",
              "title": "Robot Id"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
