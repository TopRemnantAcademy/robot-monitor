{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotmonitor.local/contracts/ws-envelope.schema.json",
  "title": "RobotMonitor WS envelope",
  "description": "ws://{host}:8000/ws/robots outbound envelope (spec/00 §5.2). OpenAPI does not describe WebSocket, so this is a separate document: the machine-readable source of truth for the WS contract, validated by frontend src/lib/wsEnvelope.ts in dev mode via ajv (not in production). The branch decision order matches the outbound order of backend_ingestion/app/main.py's ws_robots(): ① snapshot (first frame) ② telemetry ③ alert.",
  "oneOf": [
    {
      "$ref": "#/$defs/SnapshotEnvelope"
    },
    {
      "$ref": "#/$defs/TelemetryEnvelope"
    },
    {
      "$ref": "#/$defs/AlertEnvelope"
    }
  ],
  "$defs": {
    "JointDict": {
      "type": "object",
      "description": "Joint name -> value. Keys are the 24 standard keys from spec/00 §5.5.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "RobotTelemetry": {
      "type": "object",
      "description": "Byte-for-byte consistent with backend /openapi.json's RobotTelemetryOut (joint_positions must be included; see the STATUS.md §6.2 incident). is_online (required) / last_seen (optional, may be null) were added by ISSUE #77: the source of truth for online judgment switched from the robot's self-reported status_code to the backend receive-side last_seen.",
      "required": [
        "robot_id",
        "status_code",
        "battery_pct",
        "max_joint_temp",
        "joint_temperatures",
        "joint_positions",
        "joint_torques",
        "error_code",
        "ts",
        "is_online"
      ],
      "properties": {
        "robot_id": {
          "type": "string",
          "pattern": "^humanoid-[0-9]{3}$"
        },
        "status_code": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "error_code": {
          "type": "integer"
        },
        "battery_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "max_joint_temp": {
          "type": "number"
        },
        "joint_temperatures": {
          "$ref": "#/$defs/JointDict"
        },
        "joint_positions": {
          "$ref": "#/$defs/JointDict"
        },
        "joint_torques": {
          "$ref": "#/$defs/JointDict"
        },
        "ts": {
          "type": "integer"
        },
        "is_online": {
          "type": "boolean",
          "description": "Backend-judged online flag (ISSUE #77): whether the last received telemetry is within the threshold. The frontend reads only this, no longer inferring online from status_code."
        },
        "last_seen": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Epoch seconds of the backend's last received telemetry for this robot (receive-side fact); null if never reported."
        }
      }
    },
    "RobotAlert": {
      "type": "object",
      "description": "Alert (spec/00 §5.2 ③), forwarded via Redis robot:alerts.",
      "required": [
        "robot_id",
        "rule_id",
        "severity",
        "message",
        "ts"
      ],
      "properties": {
        "robot_id": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "message": {
          "type": "string"
        },
        "ts": {
          "type": "integer"
        }
      }
    },
    "SnapshotEnvelope": {
      "type": "object",
      "description": "① First frame: full snapshot of 100 robots.",
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "snapshot"
        },
        "data": {
          "type": "object",
          "required": [
            "robots"
          ],
          "additionalProperties": false,
          "properties": {
            "robots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RobotTelemetry"
              }
            }
          }
        }
      }
    },
    "TelemetryEnvelope": {
      "type": "object",
      "description": "② Incremental telemetry: single robot.",
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "telemetry"
        },
        "data": {
          "$ref": "#/$defs/RobotTelemetry"
        }
      }
    },
    "AlertEnvelope": {
      "type": "object",
      "description": "③ Alert: single entry.",
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "alert"
        },
        "data": {
          "$ref": "#/$defs/RobotAlert"
        }
      }
    }
  }
}
