# Secrets and local environment (.env.example is a template and must be committed)
.env
.env.*
!.env.example
*.local

# Python
__pycache__/
*.pyc
.venv/
# `.venv*/` also covers CI-side venv dirs like `.venv-ci`:
# `fix/issue19-p0-gaps` once accidentally committed the whole `.venv-ci/` (symlink + pyvenv.cfg),
# writing only `.venv/` could not block it. Confirmed: `git check-ignore .venv-ci/pyvenv.cfg` hits this line.
.venv*/
venv/
.pytest_cache/

# Node
node_modules/
dist/
build/

# Logs
*.log

# Externally downloaded reference sources: only the attribution manifest and
# integration plan are committed; third-party source does not enter the main repo
external/*
!external/SOURCES.md
!external/INTEGRATION-PLAN.md
!external/fetch-sources.sh
!external/ORDER12-VERIFICATION.md

# k6 / load test (Order 23): binaries and local run artifacts are not committed -- the 47 MB k6
# extended binary is a "tool" not "source"; the tarball does not enter git; run summaries are
# produced by scripts and are local evidence. See tests/load/README.md §3 for how to obtain it.
k6-mqtt
k6
tests/load/last-run.json
tests/load/last-ws-run.json

# OS
.DS_Store

# Redis local snapshot (generated by redis-server during local verification; not committed)
dump.rdb

# Ops-layer local state (Grafana-created dashboards are not committed; source is infra/ops/grafana/dashboards)
infra/ops/grafana/data/
