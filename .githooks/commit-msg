#!/bin/sh
# .githooks/commit-msg — 拦截提交信息中的 AI 水印（项目硬性规则）
#
# 触发：git commit 时，参数 $1 为存放提交信息的临时文件路径。
# 行为：逐行扫描提交信息（跳过以 '#' 开头的 git 注释行），若命中 AI 水印模式则拒绝提交。
#
# 目的：本项目规定 commit message 严禁出现 AI 助手署名 / "由 AI 生成" 等 boilerplate。
#       此前已发现 52 个历史提交含 `Co-Authored-By: CodeBuddy` 与 `@//codebuddy/` 路由标记泄漏，
#       本钩子防止此类模式再次进入仓库历史。
#
# 绕过：如确需提交（极少情况），可用 `git commit --no-verify`，但应尽量避免。

COMMIT_MSG_FILE="$1"
[ -f "$COMMIT_MSG_FILE" ] || exit 0

block=0
matched=""

while IFS= read -r line; do
  # git 自动生成的注释行（以 # 开头）不参与判定
  case "$line" in
    \#*) continue ;;
  esac

  # 1) AI 助手署名（Co-Authored-By: <AI 工具>）
  if echo "$line" | grep -qiE 'co-authored-by:[[:space:]]*(codebuddy|claude|chatgpt|openai|anthropic|copilot|gemini|workbuddy|cursor|deepseek|ai)'; then
    block=1; matched="$line"; break
  fi

  # 2) 通用「由 AI 生成 / 编写」表述
  if echo "$line" | grep -qiE '(generated|created|written|produced)[[:space:]]+by[[:space:]]+ai|this commit was generated|由 ai 生成|ai 助手'; then
    block=1; matched="$line"; break
  fi

  # 3) AI 派单路由标记（不应出现在提交信息里）
  case "$line" in
    *@//codebuddy/*) block=1; matched="$line"; break ;;
  esac
done < "$COMMIT_MSG_FILE"

if [ "$block" -eq 1 ]; then
  echo "" >&2
  echo "ERROR: commit message contains an AI watermark and was rejected:" >&2
  echo "    $matched" >&2
  echo "" >&2
  echo "    Project rule: commit messages must NOT contain AI-assistant co-authors" >&2
  echo "    or 'generated by AI' boilerplate." >&2
  echo "    Rewrite the message (remove AI-tool co-authors and @//codebuddy/ markers), then retry." >&2
  echo "    To override in rare cases: git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

exit 0
