#!/bin/sh
# .githooks/commit-msg — block AI watermarks in commit messages (project hard rule)
#
# Trigger: on git commit, $1 is the temp file holding the commit message.
# Behavior: scan the commit message line by line (skipping git comment lines that
# start with '#'); reject the commit if an AI watermark pattern matches.
#
# Purpose: this project forbids AI-assistant attributions / "generated by AI"
# boilerplate in commit messages.
#       Previously 52 historical commits were found leaking `Co-Authored-By: CodeBuddy`
#       and `@//codebuddy/` routing markers; this hook prevents such patterns from
#       entering repo history again.
#
# Bypass: only if truly needed (rare), use `git commit --no-verify`, but avoid it.

COMMIT_MSG_FILE="$1"
[ -f "$COMMIT_MSG_FILE" ] || exit 0

block=0
matched=""

while IFS= read -r line; do
  # git auto-generated comment lines (starting with #) are not considered
  case "$line" in
    \#*) continue ;;
  esac

  # 1) AI assistant attribution (Co-Authored-By: <AI tool>)
  if echo "$line" | grep -qiE 'co-authored-by:[[:space:]]*(codebuddy|claude|chatgpt|openai|anthropic|copilot|gemini|workbuddy|cursor|deepseek|ai)'; then
    block=1; matched="$line"; break
  fi

  # 2) Generic "generated / written by AI" phrasing
  if echo "$line" | grep -qiE '(generated|created|written|produced)[[:space:]]+by[[:space:]]+ai|this commit was generated|ai assistant'; then
    block=1; matched="$line"; break
  fi

  # 3) AI dispatch routing marker (should not appear in commit messages)
  case "$line" in
    *@//codebuddy/*) block=1; matched="$line"; break ;;
  esac
done < "$COMMIT_MSG_FILE"

if [ "$block" -eq 1 ]; then
  echo "" >&2
  echo "ERROR: commit message contains an AI watermark and was rejected:" >&2
  echo "    $matched" >&2
  echo "" >&2
  echo "    Project rule: commit messages must NOT contain AI-assistant co-authors" >&2
  echo "    or 'generated by AI' boilerplate." >&2
  echo "    Rewrite the message (remove AI-tool co-authors and @//codebuddy/ markers), then retry." >&2
  echo "    To override in rare cases: git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

exit 0
