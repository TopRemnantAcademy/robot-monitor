# Only VITE_-prefixed variables are injected into the frontend by Vite (orders/05 prohibition: do not use WS_HOST)
# WS host: can be just the hostname (default port 8000), or a full ws://host:port
VITE_WS_HOST=localhost
# WS port, default 8000
VITE_WS_PORT=8000
# REST base URL (Drawer history endpoint), default http://localhost:8000
VITE_API_BASE=http://localhost:8000
