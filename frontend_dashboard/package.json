{
  "name": "robot-monitor-frontend-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "100 台人形机器人工厂监控大屏（spec/03）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-types.mjs",
    "contract:snapshot": "python3 ../scripts/export-openapi.py --out docs/contracts/openapi.snapshot.json",
    "contract:check": "python3 ../scripts/export-openapi.py --check docs/contracts/openapi.snapshot.json",
    "test:ws-contract": "node --test ./tests/*.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "echarts": "5.5.1",
    "echarts-for-react": "3.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "6.1.6",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "^8.20.0",
    "autoprefixer": "10.4.20",
    "esbuild": "^0.21.5",
    "happy-dom": "^15.11.7",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "msw": "^3.0.4",
    "postcss": "8.4.49",
    "puppeteer": "^23.11.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
