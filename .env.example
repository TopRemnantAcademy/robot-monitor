# RobotMonitor 环境变量模板（复制为 .env，禁止提交真实 .env）

# ---- 后端 / 告警引擎 ----
MQTT_BROKER=localhost
MQTT_PORT=1883
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robot_monitor
BATCH_TRIGGER_COUNT=500
BATCH_TRIGGER_SECONDS=1.0
# 单批写入失败的重试与坏行隔离（见 backend_ingestion/app/services/batch_writer.py）
BATCH_FLUSH_MAX_RETRIES=3
BATCH_FLUSH_RETRY_BACKOFF_S=0.5
BATCH_ISOLATION_MAX_DEPTH=8

# ---- 认证 / RBAC（订单 15）----
# JWT 签名密钥。**必填，没有默认值**：留空则后端启动即报 ValidationError
# （宁可起不来，也不要带着一个人人可签的密钥上线 —— 那等于谁都能伪造 admin token）。
# 生成：openssl rand -hex 32
# ⚠️ 真实值绝不入库；.gitignore 已排除 .env，.dockerignore 已排除 .env（AGENTS.md §5）
JWT_SECRET=replace-me-with-openssl-rand-hex-32
# token 有效期（秒）。默认 8 小时 = 一个班次。
JWT_LIFETIME_SECONDS=28800

# ---- asyncpg 连接池 ----
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_S=30
DB_MAX_IDLE_S=300
DB_HEALTH_CACHE_S=5

# 后端监听地址
WS_HOST=0.0.0.0

# ---- 告警通知（I-14）----
# 工厂侧群机器人 webhook。留空 = 关闭通知（默认）。
# 钉钉: https://oapi.dingtalk.com/robot/send?access_token=xxx
# 企微: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# ⚠️ 含 token，禁止提交真实值
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=generic        # dingtalk | wecom | generic
ALERT_WEBHOOK_MIN_SEVERITY=3      # 3 = 只推 critical

# ---- 前端（Vite 只暴露 VITE_ 前缀变量）----
# 旧版只有 WS_HOST，前端 import.meta.env.VITE_WS_HOST 读不到 → 必须带 VITE_ 前缀。
VITE_WS_HOST=localhost
VITE_API_BASE=http://localhost:8000

# ---- 运维/可观测性层（infra/docker-compose.yml 的 ops profile）----
# 启动：docker compose -f infra/docker-compose.yml --profile ops up -d
# Grafana 管理口令：本地开发默认 admin/admin，生产必须覆盖
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# emqx-exporter 需要 EMQX Dashboard 的 API Key/Secret
# 生成路径：EMQX Dashboard(http://localhost:18083) → System → API Keys
# 保留占位值则 exporter 的 metrics 段会取不到数据（probes 段不受影响）
EMQX_EXPORTER_API_KEY=replace-me
EMQX_EXPORTER_API_SECRET=replace-me

# pgBackRest 仓库加密口令（infra/ops/pgbackrest/pgbackrest.conf 引用）
# ⚠️ 真实值绝不入库；当前 pgbackrest 尚未接线进 compose
PGBACKREST_CIPHER_PASS=replace-me
