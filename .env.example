# RobotMonitor 环境变量模板（复制为 .env，禁止提交真实 .env）

# ---- 后端 / 告警引擎 ----
MQTT_BROKER=localhost
MQTT_PORT=1883
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robot_monitor
BATCH_TRIGGER_COUNT=500
BATCH_TRIGGER_SECONDS=1.0
# 单批写入失败的重试与坏行隔离（见 backend_ingestion/app/services/batch_writer.py）
BATCH_FLUSH_MAX_RETRIES=3
BATCH_FLUSH_RETRY_BACKOFF_S=0.5
BATCH_ISOLATION_MAX_DEPTH=8

# ---- robot_metadata 心跳（G-6 / ISSUE #96）----
# 总开关。关闭后 metadata_writer 不写 robot_metadata、也不做离线扫描；
# 既有遥测写路径（batch_writer）语义与吞吐不受影响。
METADATA_HEARTBEAT_ENABLED=true
# 心跳刷盘周期（秒）。按 robot_id 折叠后一条语句批量 UPDATE。
# 不要大于 STATE_TTL_SECONDS：否则会出现「Redis 已判过期、DB 里 is_online 还是 true」。
METADATA_FLUSH_SECONDS=1.0
# Redis 最新状态缓存的 TTL（秒）。同时是 robot_metadata.is_online 的离线阈值
# —— metadata_writer 对「超过该秒数无遥测」的机器人周期置 is_online=false。
STATE_TTL_SECONDS=10

# ---- 认证 / RBAC（订单 15）----
# JWT 签名密钥。**必填，没有默认值**：留空则后端启动即报 ValidationError
# （宁可起不来，也不要带着一个人人可签的密钥上线 —— 那等于谁都能伪造 admin token）。
# 生成：openssl rand -hex 32
# ⚠️ 真实值绝不入库；.gitignore 已排除 .env，.dockerignore 已排除 .env（AGENTS.md §5）
JWT_SECRET=replace-me-with-openssl-rand-hex-32
# token 有效期（秒）。默认 8 小时 = 一个班次。
JWT_LIFETIME_SECONDS=28800

# ---- asyncpg 连接池 ----
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_S=30
DB_MAX_IDLE_S=300
DB_HEALTH_CACHE_S=5

# 后端监听地址
WS_HOST=0.0.0.0

# ---- WS 合成探针（缺口 G-3「看板假的绿」）----
# 客户端视角验活：真连一次 ws://127.0.0.1:${WS_PORT}/ws/robots 并等首帧 snapshot，
# 与 robot_backend_ws_connections（服务端连接数）互补。免鉴权（token 自签）。
# 探针是旁观者：关闭或跑挂都不影响遥测写入与广播。间隔下限 30s（代码里钳住）。
WS_PROBE_ENABLED=true
WS_PROBE_INTERVAL_S=60
WS_PROBE_PATH=/ws/robots
WS_PROBE_STARTUP_GRACE_S=5

# ---- 告警通知（I-14）----
# 工厂侧群机器人 webhook。留空 = 关闭通知（默认）。
# 钉钉: https://oapi.dingtalk.com/robot/send?access_token=xxx
# 企微: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# ⚠️ 含 token，禁止提交真实值
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=generic        # dingtalk | wecom | generic
ALERT_WEBHOOK_MIN_SEVERITY=3      # 3 = 只推 critical

# ---- 前端（Vite 只暴露 VITE_ 前缀变量）----
# 旧版只有 WS_HOST，前端 import.meta.env.VITE_WS_HOST 读不到 → 必须带 VITE_ 前缀。
VITE_WS_HOST=localhost
VITE_API_BASE=http://localhost:8000

# ---- TimescaleDB 凭据（infra/docker-compose.yml + 观测层 postgres-exporter 共用）----
# 基础 compose 的 timescaledb service 用这三项初始化库；
# infra/observability/docker-compose.observability.yml 的 postgres-exporter
# 会拼进 DATA_SOURCE_NAME（订单 22 / I-12）。两处读同一组变量 → 不会各改各的。
# ⚠️ 生产环境务必覆盖 POSTGRES_PASSWORD；模板里的值仅供本地开发。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=robot_monitor

# ---- OpenTelemetry（订单 16 T3）----
# 留空 = 关闭（默认，no-op）。工厂内网无 OTLP collector 时保持为空即可，
# 服务**不会**因未配置而启动失败。启用时填 base 地址，本模块自动补 /v1/traces。
# 例：OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=robot_backend

# ---- 运维/可观测性层（infra/docker-compose.yml 的 ops profile）----
# 启动：docker compose -f infra/docker-compose.yml --profile ops up -d
# Grafana 管理口令：本地开发默认 admin/admin，生产必须覆盖
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# emqx-exporter 需要 EMQX Dashboard 的 API Key/Secret
# 生成路径：EMQX Dashboard(http://localhost:18083) → System → API Keys
# 保留占位值则 exporter 的 metrics 段会取不到数据（probes 段不受影响）
EMQX_EXPORTER_API_KEY=replace-me
EMQX_EXPORTER_API_SECRET=replace-me

# pgBackRest 仓库加密口令（infra/ops/pgbackrest/pgbackrest.conf 引用）
# ⚠️ 真实值绝不入库；.gitignore 排除 .env，.dockerignore 排除 .env（AGENTS.md §5）
# 生成（官方建议，见 docs/DR-RUNBOOK.md §5）：openssl rand -base64 48
# compose 用 ${PGBACKREST_CIPHER_PASS:?…}：未设置则直接报错退出，杜绝空密钥仓库
# 已接线：infra/ops/pgbackrest/docker-compose.dr.yml（灾备 overlay，订单 25）
PGBACKREST_CIPHER_PASS=replace-me
