# RobotMonitor environment variable template (copy to .env; never commit the real .env)

# ---- Backend / alert engine ----
MQTT_BROKER=localhost
MQTT_PORT=1883
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robot_monitor
BATCH_TRIGGER_COUNT=500
BATCH_TRIGGER_SECONDS=1.0
# Retries and bad-row isolation for a single-batch write failure (see backend_ingestion/app/services/batch_writer.py)
BATCH_FLUSH_MAX_RETRIES=3
BATCH_FLUSH_RETRY_BACKOFF_S=0.5
BATCH_ISOLATION_MAX_DEPTH=8

# ---- robot_metadata heartbeat (G-6 / ISSUE #96) ----
# Master switch. When off, metadata_writer will not write robot_metadata nor run the offline scan;
# the existing telemetry write path (batch_writer) semantics and throughput are unaffected.
METADATA_HEARTBEAT_ENABLED=true
# Heartbeat flush period (seconds). A single batched UPDATE folded by robot_id.
# Must not exceed STATE_TTL_SECONDS, otherwise "Redis already judged expired but DB still has is_online=true" can occur.
METADATA_FLUSH_SECONDS=1.0
# TTL (seconds) of Redis latest-state cache. Also the offline threshold for robot_metadata.is_online
# -- metadata_writer periodically sets is_online=false for robots with no telemetry for longer than this many seconds.
STATE_TTL_SECONDS=10

# ---- Auth / RBAC (Order 15) ----
# JWT signing secret. **Required, no default**: empty value makes the backend fail at startup with ValidationError
# (better to not start than to ship with a secret everyone could forge admin tokens from).
# Generate with: openssl rand -hex 32
# WARNING: real value must never enter the repo; .gitignore excludes .env, .dockerignore excludes .env (AGENTS.md §5)
JWT_SECRET=replace-me-with-openssl-rand-hex-32
# Token lifetime (seconds). Default 8 hours = one shift.
JWT_LIFETIME_SECONDS=28800

# ---- asyncpg connection pool ----
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_S=30
DB_MAX_IDLE_S=300
DB_HEALTH_CACHE_S=5

# ---- CORS / rate limit (R-17) ----
# Allowed cross-origin origins, comma-separated. **Default empty = CORS middleware disabled** (same-origin deploy is enough).
# WARNING: do not fill `*` just to "make it run": `*` lets any site hit the backend with the user's credentials
# (CSRF/info-leak surface). In production list the real frontend origins explicitly.
# Example: CORS_ALLOW_ORIGINS=http://localhost:5173,https://board.example.com
CORS_ALLOW_ORIGINS=

# Optional rate limiting (enable only when exposing publicly / to prevent abuse). Default false = no limit;
# existing e2e/probe/monitoring request cadence unchanged. When enabled, counts a fixed window per client IP,
# capped at RATE_LIMIT_PER_MINUTE per client IP. **Always exempt**: /healthz, /metrics, /ws/robots, /internal/*.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120

# Backend listen address
WS_HOST=0.0.0.0

# ---- WS synthetic probe (gap G-3 "dashboard shows fake green") ----
# Client-side liveness check: actually connect once to ws://127.0.0.1:${WS_PORT}/ws/robots and wait for the first
# snapshot frame, complementing robot_backend_ws_connections (server-side connection count). No auth (self-signed token).
# The probe is an observer: disabling or crashing it does not affect telemetry writes or broadcast. Min interval 30s (clamped in code).
WS_PROBE_ENABLED=true
WS_PROBE_INTERVAL_S=60
WS_PROBE_PATH=/ws/robots
WS_PROBE_STARTUP_GRACE_S=5

# ---- Alert notifications (I-14) ----
# Factory-side group-bot webhook. Empty = notifications off (default).
# DingTalk: https://oapi.dingtalk.com/robot/send?access_token=xxx
# WeCom:    https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# WARNING: contains token, never commit a real value
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=generic        # dingtalk | wecom | generic
ALERT_WEBHOOK_MIN_SEVERITY=3      # 3 = push only critical

# ---- Frontend (Vite only exposes VITE_-prefixed variables) ----
# Old version only had WS_HOST, but frontend import.meta.env.VITE_WS_HOST cannot read it -> must use VITE_ prefix.
VITE_WS_HOST=localhost
VITE_API_BASE=http://localhost:8000

# ---- TimescaleDB credentials (shared by infra/docker-compose.yml + observability postgres-exporter) ----
# The base compose's timescaledb service is initialized from these three;
# infra/observability/docker-compose.observability.yml's postgres-exporter
# builds DATA_SOURCE_NAME from them (Order 22 / I-12). Both read the same variables -> no drift.
# WARNING: in production always override POSTGRES_PASSWORD; template values are for local dev only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=robot_monitor

# ---- OpenTelemetry (Order 16 T3) ----
# Empty = disabled (default, no-op). When the factory intranet has no OTLP collector, keep empty;
# the service will NOT fail to start due to missing config. When enabled, fill the base URL; this module
# auto-appends /v1/traces.
# Example: OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=robot_backend

# ---- Ops/observability layer (ops profile of infra/docker-compose.yml) ----
# Start: docker compose -f infra/docker-compose.yml --profile ops up -d
# Grafana admin password: local dev default admin/admin; must override in production
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# emqx-exporter needs the EMQX Dashboard API Key/Secret
# Create at: EMQX Dashboard (http://localhost:18083) -> System -> API Keys
# If left as placeholder, the exporter's metrics section gets no data (probes section unaffected)
EMQX_EXPORTER_API_KEY=replace-me
EMQX_EXPORTER_API_SECRET=replace-me

# pgBackRest repo encryption password (referenced by infra/ops/pgbackrest/pgbackrest.conf)
# WARNING: real value must never enter the repo; .gitignore excludes .env, .dockerignore excludes .env (AGENTS.md §5)
# Generate (official recommendation, see docs/DR-RUNBOOK.md §5): openssl rand -base64 48
# compose uses ${PGBACKREST_CIPHER_PASS:?...}: errors out if unset, preventing an empty-key repo
# Already wired: infra/ops/pgbackrest/docker-compose.dr.yml (DR overlay, Order 25)
PGBACKREST_CIPHER_PASS=replace-me
