# e2e-specific simulator image (ISSUE #60).
#
# Why a separate file instead of reusing simulator/: simulator currently has **no** Dockerfile
# (it runs bare on the host, see simulator/README.md), while e2e requires the entry point to be
# containerized too, so the entire "100 robots × 10Hz real persistence" chain runs on one network.
#
# Base image matches backend_ingestion (python:3.11-slim): aiomqtt 2.0.1 ships a wheel,
# so no gcc is needed; the rest of the repo's Python services also pin 3.11.
FROM python:3.11-slim

WORKDIR /app

# Reuse simulator/requirements.txt directly (aiomqtt 2.0.1 + rich 13.7.1).
# Deliberately **no new** e2e-specific requirements: that would create two sources of truth for the
# simulator's deps, and a future aiomqtt upgrade would inevitably miss one (README already pins 2.0.1 on the simulator side).
COPY simulator/requirements.txt /app/simulator/requirements.txt
RUN pip install --no-cache-dir -r /app/simulator/requirements.txt

COPY simulator /app/simulator

# The slim image needs nothing beyond pyc files; the simulator exposes no external port.
CMD ["python", "/app/simulator/mock_fleet.py", "--help"]
